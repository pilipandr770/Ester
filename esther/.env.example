APP_ENV=production
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
BASE_URL=https://esther.example.com
# Сколько reverse proxy стоит перед приложением (для реального IP и https)
PROXY_HOPS=1

# Пароли БД (используются docker-compose; лучше hex/urlsafe без спецсимволов)
DB_PASSWORD=
EVO_DB_PASSWORD=

# Evolution API (self-hosted, см. docker-compose.yml)
EVOLUTION_URL=http://evolution:8080
EVOLUTION_API_KEY=
# Адрес, по которому Evolution достучится до Эстер (внутри docker-сети)
WEBHOOK_BASE=http://web:8000

# ИИ
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MODEL_FAST=claude-haiku-5-5
MODEL_SMART=claude-sonnet-5-5

# Stripe: 10 EUR / месяц
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=price_1UVqnn069FHIEWIlukhT8uuy
STRIPE_WEBHOOK_SECRET=
# 1, если в Stripe включён Stripe Tax (НДС)
STRIPE_AUTOMATIC_TAX=0
TRIAL_DAYS=7

# Почта для сброса пароля
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=1

# Лимиты попыток входа. memory:// считается отдельно в каждом воркере; для точности redis://...
RATELIMIT_STORAGE_URI=memory://

# Мониторинг ошибок (необязательно). Тела запросов и переменные в Sentry не отправляются.
SENTRY_DSN=

# Лимиты расходов на ИИ и очередь
MAX_CHATS=10
MAX_MESSAGES_PER_DAY=500
MAX_MEDIA_PER_DAY=40
MAX_MEDIA_MB=10
MAX_AUDIO_SECONDS=300
JOB_MAX_ATTEMPTS=5

# Оператор (юрлицо в Израиле), подставляется в юридические страницы.
# В production приложение не запустится, пока эти поля пусты.
COMPANY_NAME=
COMPANY_ID=
COMPANY_ADDRESS=
CONTACT_EMAIL=
RETENTION_DAYS=30
